<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/terminal_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface"
            app:title="@string/app_name"
            app:titleTextColor="@color/on_surface"
            app:navigationIcon="@android:drawable/ic_menu_sort_by_size"
            app:menu="@menu/main" />

        <com.chimeraant.terminal.view.TabStrip
            android:id="@+id/tab_strip"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/surface" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.chimeraant.terminal.view.TerminalView
                android:id="@+id/terminal_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_new_sandbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/menu_new_session"
                android:visibility="gone" />

            <com.chimeraant.terminal.view.BotExplainerView
                android:id="@+id/bot_explainer"
                android:layout_width="230dp"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:visibility="gone" />
        </FrameLayout>

        <com.chimeraant.terminal.view.SuggestionView
            android:id="@+id/suggestion_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/extra_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_esc"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/extra_esc"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_ctrl"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/extra_ctrl"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_alt"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/extra_alt"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_tab"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="@string/extra_tab"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_arrow_up"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="&#8593;"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_arrow_down"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="&#8595;"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_arrow_left"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="&#8592;"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_arrow_right"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="&#8594;"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/key_toggle_ime"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:minWidth="0dp"
                android:text="KB"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_alt"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
